<%if(success&&success.length){%>
    <div class="alert alert-success alert-dismissible fade show " role="alert" style="border-radius: 20px;display: flex; justify-content: center; margin: 0px !important;">
        <div>
        <%=success%>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
<%}%>

<%if(err&&err.length){%>
    <div class="alert alert-danger alert-dismissible fade show " role="alert" style="border-radius: 20px; display: flex; justify-content: center; margin: 0px !important;">
        <%=err%>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<%}%>